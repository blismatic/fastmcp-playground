# ------------------------------------- MONGODB VARIABLES ---------------------------------
MONGO_USER=

MONGO_PASSWORD=

MONGO_CLUSTER=

MONGO_DB=

MONGO_COLLECTION=
# -----------------------------------------------------------------------------------------

# ------------------------------------- AUTH0 VARIABLES ---------------------------------
# This comes from the Auth0 application "domain": structured as https://<domain>/.well-known/openid-configuration
AUTH0_CONFIG_URL=

# This comes from the Auth0 application
AUTH0_CLIENT_ID=

# This comes from the Auth0 application
AUTH0_CLIENT_SECRET=

# This is the identifier from the Auth0 API application
AUTH0_AUDIENCE=

# This is the base url. For testing, it is just https://localhost:8000
AUTH0_BASE_URL=

# LOCAL DEV ONLY: disables auth on STDIO and impersonates MCP_DEV_SUB
# MCP_AUTH_ENABLED=false
# MCP_DEV_SUB=auth0|...
# -----------------------------------------------------------------------------------------

# ------------------------------------- AWS VARIABLES ---------------------------------
DYNAMO_USERS_TABLE=
DYNAMO_USERS_AUTH0_INDEX=

DYNAMO_USER_ORGS_TABLE=
DYNAMO_USER_ORGS_ACCOUNT_INDEX=

DYNAMO_ORGS_TABLE=

# AWS credentials come from boto3's standard chain -- never put keys in this file if you can avoid it.
# Local dev: name a profile from ~/.aws/config (region comes from the profile). Use the least-privilege
# role profile described in the README ("AWS credentials"), e.g. fastmcp-dev -- not personal admin credentials.
AWS_PROFILE=
# Without a profile (e.g. a container), set the region here. boto3 reads AWS_DEFAULT_REGION, NOT AWS_REGION.
# AWS_DEFAULT_REGION=us-east-1
# Deployed on AWS: set neither; use the ECS task role / EC2 instance profile instead.
# -----------------------------------------------------------------------------------------